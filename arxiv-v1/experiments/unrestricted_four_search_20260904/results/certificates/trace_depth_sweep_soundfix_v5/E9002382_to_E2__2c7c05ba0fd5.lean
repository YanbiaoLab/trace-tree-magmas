theorem nr2 (x v0 v1 : CM)
 :
    ¬ ∃ o, Code x (p v1 v1) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  cases qs0 with
  | raw =>
    have e0 := congrArg (fun q => q) ha
    change x = (p q_v0 q_v0) at e0
    have e1 := congrArg (fun q => (L q)) hb
    change v1 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) at e1
    have e2 := congrArg (fun q => (R q)) hb
    change v1 = (p q_v1 q_v1) at e2
    have cyc : q_v1 = (p q_x q_v1) := (let peq1 : v1 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := e1; let peq2 : v1 = (p q_v1 q_v1) := e2; let pst0 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = v1 := Eq.symm (peq1); let pst1 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = (p q_v1 q_v1) := Eq.trans (pst0) (peq2); let pst2 : (p q_x q_v1) = q_v1 := congrArg (fun q => L q) (pst1); let pst3 : q_v1 = (p q_x q_v1) := Eq.symm (pst2); pst3)
    have hlt : sz q_v1 < sz (p q_x q_v1) := sz_lt_p_right q_x q_v1
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have e0 := congrArg (fun q => q) ha
    change x = (p q_v0 q_v0) at e0
    have e1 := congrArg (fun q => (L q)) hb
    change v1 = (p q_H0 (p q_x (p q_v1 q_v1))) at e1
    have e2 := congrArg (fun q => (R q)) hb
    change v1 = (p q_v1 q_v1) at e2
    have cyc : q_v1 = (p q_x (p q_v1 q_v1)) := (let peq1 : v1 = (p q_H0 (p q_x (p q_v1 q_v1))) := e1; let peq2 : v1 = (p q_v1 q_v1) := e2; let pst0 : (p q_H0 (p q_x (p q_v1 q_v1))) = v1 := Eq.symm (peq1); let pst1 : (p q_H0 (p q_x (p q_v1 q_v1))) = (p q_v1 q_v1) := Eq.trans (pst0) (peq2); let pst2 : (p q_x (p q_v1 q_v1)) = q_v1 := congrArg (fun q => R q) (pst1); let pst3 : q_v1 = (p q_x (p q_v1 q_v1)) := Eq.symm (pst2); pst3)
    have hlt : sz q_v1 < sz (p q_x (p q_v1 q_v1)) := Nat.lt_trans (sz_lt_p_left q_v1 q_v1) (sz_lt_p_right q_x (p q_v1 q_v1))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
theorem nr3 (x v0 v1 H0 : CM)
    (s0 : Step x v1 H0) :
    ¬ ∃ o, Code H0 (p x (p v1 v1)) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  cases s0 with
  | raw =>
    cases qs0 with
    | raw =>
      have e0 := congrArg (fun q => (L q)) ha
      change x = q_v0 at e0
      have e1 := congrArg (fun q => (R q)) ha
      change v1 = q_v0 at e1
      have e2 := congrArg (fun q => (L q)) hb
      change x = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) at e2
      have e3 := congrArg (fun q => (L (R q))) hb
      change v1 = q_v1 at e3
      have e4 := congrArg (fun q => (R (R q))) hb
      change v1 = q_v1 at e4
      have cyc : q_v1 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := (let peq0 : x = q_v0 := e0; let peq1 : v1 = q_v0 := e1; let peq2 : x = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := e2; let peq3 : v1 = q_v1 := e3; let pst0 : q_v0 = x := Eq.symm (peq0); let pst1 : q_v0 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := Eq.trans (pst0) (peq2); let pst2 : v1 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := Eq.trans (peq1) (pst1); let pst3 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = v1 := Eq.symm (pst2); let pst4 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = q_v1 := Eq.trans (pst3) (peq3); let pst5 : q_v1 = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := Eq.symm (pst4); pst5)
      have hlt : sz q_v1 < sz (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := Nat.lt_trans (sz_lt_p_right q_x q_v1) (sz_lt_p_left (p q_x q_v1) (p q_x (p q_v1 q_v1)))
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs0h =>
      have e0 := congrArg (fun q => (L q)) ha
      change x = q_v0 at e0
      have e1 := congrArg (fun q => (R q)) ha
      change v1 = q_v0 at e1
      have e2 := congrArg (fun q => (L q)) hb
      change x = (p q_H0 (p q_x (p q_v1 q_v1))) at e2
      have e3 := congrArg (fun q => (L (R q))) hb
      change v1 = q_v1 at e3
      have e4 := congrArg (fun q => (R (R q))) hb
      change v1 = q_v1 at e4
      have cyc : q_v1 = (p q_H0 (p q_x (p q_v1 q_v1))) := (let peq0 : x = q_v0 := e0; let peq1 : v1 = q_v0 := e1; let peq2 : x = (p q_H0 (p q_x (p q_v1 q_v1))) := e2; let peq3 : v1 = q_v1 := e3; let pst0 : q_v0 = x := Eq.symm (peq0); let pst1 : q_v0 = (p q_H0 (p q_x (p q_v1 q_v1))) := Eq.trans (pst0) (peq2); let pst2 : v1 = (p q_H0 (p q_x (p q_v1 q_v1))) := Eq.trans (peq1) (pst1); let pst3 : (p q_H0 (p q_x (p q_v1 q_v1))) = v1 := Eq.symm (pst2); let pst4 : (p q_H0 (p q_x (p q_v1 q_v1))) = q_v1 := Eq.trans (pst3) (peq3); let pst5 : q_v1 = (p q_H0 (p q_x (p q_v1 q_v1))) := Eq.symm (pst4); pst5)
      have hlt : sz q_v1 < sz (p q_H0 (p q_x (p q_v1 q_v1))) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v1 q_v1) (sz_lt_p_right q_x (p q_v1 q_v1))) (sz_lt_p_right q_H0 (p q_x (p q_v1 q_v1)))
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit s0h =>
    cases qs0 with
    | raw =>
      rcases code_shape s0h with ⟨u0_x, u0_v0, u0_v1, u0_H0, u0s0, u0a, u0b, u0o⟩
      let u0s0out := u0_H0
      cases u0s0 with
      | raw =>
        have cyc : q_v1 = (p q_v1 q_v1) := (let peq1 : x = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := congrArg (fun q => (L q)) (hb); let peq5 : x = (p u0_v0 u0_v0) := u0a; let pst0 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = x := Eq.symm (peq1); let pst1 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = (p u0_v0 u0_v0) := Eq.trans (pst0) (peq5); let pst2 : (p q_x (p q_v1 q_v1)) = u0_v0 := congrArg (fun q => R q) (pst1); let pst3 : (p q_x q_v1) = u0_v0 := congrArg (fun q => L q) (pst1); let pst4 : u0_v0 = (p q_x q_v1) := Eq.symm (pst3); let pst5 : (p q_x (p q_v1 q_v1)) = (p q_x q_v1) := Eq.trans (pst2) (pst4); let pst6 : (p q_v1 q_v1) = q_v1 := congrArg (fun q => R q) (pst5); let pst7 : q_v1 = (p q_v1 q_v1) := Eq.symm (pst6); pst7)
        have hlt : sz q_v1 < sz (p q_v1 q_v1) := sz_lt_p_left q_v1 q_v1
        exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
      | hit u0s0h =>
        have cyc : q_v1 = (p q_v1 q_v1) := (let peq1 : x = (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) := congrArg (fun q => (L q)) (hb); let peq5 : x = (p u0_v0 u0_v0) := u0a; let pst0 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = x := Eq.symm (peq1); let pst1 : (p (p q_x q_v1) (p q_x (p q_v1 q_v1))) = (p u0_v0 u0_v0) := Eq.trans (pst0) (peq5); let pst2 : (p q_x (p q_v1 q_v1)) = u0_v0 := congrArg (fun q => R q) (pst1); let pst3 : (p q_x q_v1) = u0_v0 := congrArg (fun q => L q) (pst1); let pst4 : u0_v0 = (p q_x q_v1) := Eq.symm (pst3); let pst5 : (p q_x (p q_v1 q_v1)) = (p q_x q_v1) := Eq.trans (pst2) (pst4); let pst6 : (p q_v1 q_v1) = q_v1 := congrArg (fun q => R q) (pst5); let pst7 : q_v1 = (p q_v1 q_v1) := Eq.symm (pst6); pst7)
        have hlt : sz q_v1 < sz (p q_v1 q_v1) := sz_lt_p_left q_v1 q_v1
        exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs0h =>
      rcases code_shape s0h with ⟨u0_x, u0_v0, u0_v1, u0_H0, u0s0, u0a, u0b, u0o⟩
      let u0s0out := u0_H0
      cases u0s0 with
      | raw =>
        rcases code_shape qs0h with ⟨u1_x, u1_v0, u1_v1, u1_H0, u1s0, u1a, u1b, u1o⟩
        let u1s0out := u1_H0
