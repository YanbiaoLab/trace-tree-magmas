import Lean.Elab.Tactic.Omega
import JudgeProblem
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
namespace submission
inductive CM where
  | e : CM
  | k : CM → CM
  | p : CM → CM → CM
deriving DecidableEq
namespace CM
def L : CM → CM | e => e | k _ => e | p a _ => a
def R : CM → CM | e => e | k _ => e | p _ b => b
def U : CM → CM | e => e | k a => a | p _ _ => e
def sz : CM → Nat
  | e => 0
  | k a => sz a + 1
  | p a b => (sz a + 1) + (sz b + 1)
theorem sz_lt_p_left (a b : CM) : sz a < sz (p a b) := by
  change sz a < (sz a + 1) + (sz b + 1)
  exact Nat.lt_of_lt_of_le (Nat.lt_succ_self (sz a))
    (Nat.le_add_right (sz a + 1) (sz b + 1))
theorem sz_lt_p_right (a b : CM) : sz b < sz (p a b) := by
  change sz b < (sz a + 1) + (sz b + 1)
  exact Nat.lt_of_lt_of_le (Nat.lt_succ_self (sz b))
    (Nat.le_add_left (sz b + 1) (sz a + 1))
mutual
inductive Code : CM → CM → CM → Prop
  | law (x v0 v1 H0 H1 : CM)
      (s0 : Step v0 v1 H0)
      (s1 : Step v0 H0 H1) :
      Code (p (p (p (p v0 v0) H1) x) v0) v0 x
inductive Step : CM → CM → CM → Prop
  | raw (a b : CM) : Step a b (p a b)
  | hit {a b o : CM} (h : Code a b o) : Step a b o
end
theorem code_shape {a b o : CM} (h : Code a b o) :
    ∃ q_x q_v0 q_v1 q_H0 q_H1 : CM, Step q_v0 q_v1 q_H0 ∧ Step q_v0 q_H0 q_H1 ∧ a = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) ∧ b = q_v0 ∧ o = q_x := by
  exact match h with
  | .law x v0 v1 H0 H1 s0 s1 => ⟨x, v0, v1, H0, H1, s0, s1, rfl, rfl, rfl⟩
def getOut (a b : CM) : CM := (R (L a))
theorem code_get {a b o : CM} (h : Code a b o) : getOut a b = o := by
  cases h <;> rfl
theorem code_unique {a b o q : CM} (h : Code a b o) (k : Code a b q) : o = q :=
  (code_get h).symm.trans (code_get k)
theorem code_bounds {a b o : CM} (h : Code a b o) : sz b < sz a ∧ sz o < sz a := by
  rcases code_shape h with ⟨q_x, q_v0, q_v1, q_H0, q_H1, s0, s1, ha, hb, ho⟩
  subst a
  subst b
  subst o
  simp only [sz] <;> omega

theorem step_ne_first {a b : CM} : ¬ Step a b a := by
  intro h
  cases h with
  | hit hc =>
    have hb := (code_bounds hc).2
    omega
theorem step_bound {a b o : CM} (h : Step a b o) :
    sz b < sz (p o a) := by
  cases h with
  | raw => simp [sz] <;> omega
  | hit hc =>
    have hb := (code_bounds hc).1
    simp [sz] at hb ⊢ <;> omega

noncomputable def eval (a b : CM) : CM := by
  classical
  exact if h : ∃ o, Code a b o then Classical.choose h else p a b
theorem eval_hit {{a b o : CM}} (h : Code a b o) : eval a b = o := by
  rw [eval, dif_pos ⟨o, h⟩]
  exact code_unique (Classical.choose_spec ⟨o, h⟩) h
theorem eval_raw {{a b : CM}} (h : ¬ ∃ o, Code a b o) : eval a b = p a b := by
  rw [eval, dif_neg h]
theorem eval_step (a b : CM) : Step a b (eval a b) := by
  by_cases h : ∃ o, Code a b o
  · rcases h with ⟨o, hc⟩
    rw [eval_hit hc]
    exact Step.hit hc
  · rw [eval_raw h]
    exact Step.raw a b
theorem code_no_pair_left (v k : CM) :
    ¬ ∃ o, Code (p v k) v o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, q_H1, qs0, qs1, ha, hb, ho⟩
  have qs0B := step_bound qs0
  cases qs0 with
  | raw =>
    have qs1B := step_bound qs1
    cases qs1 with
    | raw =>
      have e0 := congrArg (fun q => (L q)) ha
      change v = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) at e0
      have e1 := congrArg (fun q => (R q)) ha
      change k = q_v0 at e1
      have e2 := congrArg (fun q => q) hb
      change v = q_v0 at e2
      have cyc : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := (let peq0 : v = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := e0; let peq2 : v = q_v0 := e2; let pst0 : (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) = v := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) = q_v0 := Eq.trans (pst0) (peq2); let pst2 : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1)))) (sz_lt_p_left (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs1h =>
      have e0 := congrArg (fun q => (L q)) ha
      change v = (p (p (p q_v0 q_v0) q_H1) q_x) at e0
      have e1 := congrArg (fun q => (R q)) ha
      change k = q_v0 at e1
      have e2 := congrArg (fun q => q) hb
      change v = q_v0 at e2
      have cyc : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := (let peq0 : v = (p (p (p q_v0 q_v0) q_H1) q_x) := e0; let peq2 : v = q_v0 := e2; let pst0 : (p (p (p q_v0 q_v0) q_H1) q_x) = v := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) q_H1) q_x) = q_v0 := Eq.trans (pst0) (peq2); let pst2 : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) q_H1) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_H1)) (sz_lt_p_left (p (p q_v0 q_v0) q_H1) q_x)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have qs1B := step_bound qs1
    cases qs1 with
    | raw =>
      have e0 := congrArg (fun q => (L q)) ha
      change v = (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) at e0
      have e1 := congrArg (fun q => (R q)) ha
      change k = q_v0 at e1
      have e2 := congrArg (fun q => q) hb
      change v = q_v0 at e2
      have cyc : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) := (let peq0 : v = (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) := e0; let peq2 : v = q_v0 := e2; let pst0 : (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) = v := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) = q_v0 := Eq.trans (pst0) (peq2); let pst2 : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) (p q_v0 q_H0))) (sz_lt_p_left (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs1h =>
      have e0 := congrArg (fun q => (L q)) ha
      change v = (p (p (p q_v0 q_v0) q_H1) q_x) at e0
      have e1 := congrArg (fun q => (R q)) ha
      change k = q_v0 at e1
      have e2 := congrArg (fun q => q) hb
      change v = q_v0 at e2
      have cyc : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := (let peq0 : v = (p (p (p q_v0 q_v0) q_H1) q_x) := e0; let peq2 : v = q_v0 := e2; let pst0 : (p (p (p q_v0 q_v0) q_H1) q_x) = v := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) q_H1) q_x) = q_v0 := Eq.trans (pst0) (peq2); let pst2 : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) q_H1) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_H1)) (sz_lt_p_left (p (p q_v0 q_v0) q_H1) q_x)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
theorem step_no_first {a b o : CM} (st : Step a b o) :
    ¬ ∃ u, Code o a u := by
  cases st with
  | raw => exact code_no_pair_left a b
  | hit sh =>
    rintro ⟨u, hk⟩
    have ho := (code_bounds sh).2
    have ha := (code_bounds hk).1
    omega
theorem nr0 (x v0 v1 : CM)
 :
    ¬ ∃ o, Code v0 v0 o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, q_H1, qs0, qs1, ha, hb, ho⟩
  have qs0B := step_bound qs0
  have qs0N := step_no_first qs0
  cases qs0 with
  | raw =>
    have qs1B := step_bound qs1
    have qs1N := step_no_first qs1
    cases qs1 with
    | raw =>
      have e0 := congrArg (fun q => q) ha
      change v0 = (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) at e0
      have e1 := congrArg (fun q => q) hb
      change v0 = q_v0 at e1
      have cyc : q_v0 = (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) := (let peq0 : v0 = (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) = v0 := Eq.symm (peq0); let pst1 : (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1)))) (sz_lt_p_left (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x)) (sz_lt_p_left (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) q_v0)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs1h =>
      have e0 := congrArg (fun q => q) ha
      change v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) at e0
      have e1 := congrArg (fun q => q) hb
      change v0 = q_v0 at e1
      have cyc : q_v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := (let peq0 : v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) = v0 := Eq.symm (peq0); let pst1 : (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_H1)) (sz_lt_p_left (p (p q_v0 q_v0) q_H1) q_x)) (sz_lt_p_left (p (p (p q_v0 q_v0) q_H1) q_x) q_v0)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have qs1B := step_bound qs1
    have qs1N := step_no_first qs1
    cases qs1 with
    | raw =>
      have e0 := congrArg (fun q => q) ha
      change v0 = (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) at e0
      have e1 := congrArg (fun q => q) hb
      change v0 = q_v0 at e1
      have cyc : q_v0 = (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) := (let peq0 : v0 = (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) = v0 := Eq.symm (peq0); let pst1 : (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) (p q_v0 q_H0))) (sz_lt_p_left (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x)) (sz_lt_p_left (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) q_v0)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs1h =>
      have e0 := congrArg (fun q => q) ha
      change v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) at e0
      have e1 := congrArg (fun q => q) hb
      change v0 = q_v0 at e1
      have cyc : q_v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := (let peq0 : v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) = v0 := Eq.symm (peq0); let pst1 : (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := Eq.symm (pst1); pst2)
      have hlt : sz q_v0 < sz (p (p (p (p q_v0 q_v0) q_H1) q_x) q_v0) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_H1)) (sz_lt_p_left (p (p q_v0 q_v0) q_H1) q_x)) (sz_lt_p_left (p (p (p q_v0 q_v0) q_H1) q_x) q_v0)
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
theorem nr1 (x v0 v1 H1 : CM)
    (s1 : Step v0 H0 H1) :
    ¬ ∃ o, Code (p v0 v0) H1 o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, q_H1, qs0, qs1, ha, hb, ho⟩
  have s1B := step_bound s1
  have s1N := step_no_first s1
  cases s1 with
  | raw =>
    have qs0B := step_bound qs0
    have qs0N := step_no_first qs0
    cases qs0 with
    | raw =>
      have qs1B := step_bound qs1
      have qs1N := step_no_first qs1
      cases qs1 with
      | raw =>
        have e0 := congrArg (fun q => (L q)) ha
        change v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) at e0
        have e1 := congrArg (fun q => (R q)) ha
        change v0 = q_v0 at e1
        have e2 := congrArg (fun q => q) hb
        change (p v0 H0) = q_v0 at e2
        have cyc : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := (let peq0 : v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) = v0 := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := Eq.symm (pst1); pst2)
        have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1)))) (sz_lt_p_left (p (p q_v0 q_v0) (p q_v0 (p q_v0 q_v1))) q_x)
        exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
      | hit qs1h =>
        have e0 := congrArg (fun q => (L q)) ha
        change v0 = (p (p (p q_v0 q_v0) q_H1) q_x) at e0
        have e1 := congrArg (fun q => (R q)) ha
        change v0 = q_v0 at e1
        have e2 := congrArg (fun q => q) hb
        change (p v0 H0) = q_v0 at e2
        have cyc : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := (let peq0 : v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := e0; let peq1 : v0 = q_v0 := e1; let pst0 : (p (p (p q_v0 q_v0) q_H1) q_x) = v0 := Eq.symm (peq0); let pst1 : (p (p (p q_v0 q_v0) q_H1) q_x) = q_v0 := Eq.trans (pst0) (peq1); let pst2 : q_v0 = (p (p (p q_v0 q_v0) q_H1) q_x) := Eq.symm (pst1); pst2)
        have hlt : sz q_v0 < sz (p (p (p q_v0 q_v0) q_H1) q_x) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_H1)) (sz_lt_p_left (p (p q_v0 q_v0) q_H1) q_x)
        exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs0h =>
      have qs1B := step_bound qs1
      have qs1N := step_no_first qs1
      cases qs1 with
      | raw =>
        have e0 := congrArg (fun q => (L q)) ha
        change v0 = (p (p (p q_v0 q_v0) (p q_v0 q_H0)) q_x) at e0
        have e1 := congrArg (fun q => (R q)) ha
        change v0 = q_v0 at e1
