import Lean.Elab.Tactic.Omega
import JudgeProblem
set_option maxRecDepth 100000
set_option maxHeartbeats 1000000
namespace submission
inductive CM where
  | e : CM
  | k : CM → CM
  | p : CM → CM → CM
deriving DecidableEq
namespace CM
def L : CM → CM | e => e | k _ => e | p a _ => a
def R : CM → CM | e => e | k _ => e | p _ b => b
def U : CM → CM | e => e | k a => a | p _ _ => e
def sz : CM → Nat
  | e => 0
  | k a => sz a + 1
  | p a b => (sz a + 1) + (sz b + 1)
theorem sz_lt_p_left (a b : CM) : sz a < sz (p a b) := by
  change sz a < (sz a + 1) + (sz b + 1)
  exact Nat.lt_of_lt_of_le (Nat.lt_succ_self (sz a))
    (Nat.le_add_right (sz a + 1) (sz b + 1))
theorem sz_lt_p_right (a b : CM) : sz b < sz (p a b) := by
  change sz b < (sz a + 1) + (sz b + 1)
  exact Nat.lt_of_lt_of_le (Nat.lt_succ_self (sz b))
    (Nat.le_add_left (sz b + 1) (sz a + 1))
mutual
inductive Code : CM → CM → CM → Prop
  | law (x v0 v1 H0 : CM)
      (s0 : Step x v0 H0) :
      Code v0 (p H0 (p v1 (p (p v0 v0) v0))) x
inductive Step : CM → CM → CM → Prop
  | raw (a b : CM) : Step a b (p a b)
  | hit {a b o : CM} (h : Code a b o) : Step a b o
end
theorem code_shape {a b o : CM} (h : Code a b o) :
    ∃ q_x q_v0 q_v1 q_H0 : CM, Step q_x q_v0 q_H0 ∧ a = q_v0 ∧ b = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) ∧ o = q_x := by
  exact match h with
  | .law x v0 v1 H0 s0 => ⟨x, v0, v1, H0, s0, rfl, rfl, rfl⟩
def getKey (c : CM) : CM := (L (L (R (R c))))
theorem code_key {a b o : CM} (h : Code a b o) : getKey b = a := by
  cases h <;> rfl
theorem code_key_unique {a q b o : CM} (h : Code a b o) (k : Code q b o) : a = q :=
  (code_key h).symm.trans (code_key k)
theorem code_key_small {a b o : CM} (h : Code a b o) : sz a < sz b := by
  rcases code_shape h with ⟨q_x, q_v0, q_v1, q_H0, s0, ha, hb, ho⟩
  subst a
  subst b
  exact Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_v0)) (sz_lt_p_right q_v1 (p (p q_v0 q_v0) q_v0))) (sz_lt_p_right q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0)))
theorem code_bounds {a b o : CM} (h : Code a b o) :
    sz a < sz b ∧ sz o < sz b := by
  rcases code_shape h with ⟨q_x, q_v0, q_v1, q_H0, s0, ha, hb, ho⟩
  subst a
  subst b
  subst o
  constructor
  · exact Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_v0)) (sz_lt_p_right q_v1 (p (p q_v0 q_v0) q_v0))) (sz_lt_p_right q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0)))
  ·
    cases s0 with
    | raw =>
      exact Nat.lt_trans (sz_lt_p_left q_x q_v0) (sz_lt_p_left (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0)))
    | hit h0 =>
      exact Nat.lt_trans (code_key_small h0) (Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_v0)) (sz_lt_p_right q_v1 (p (p q_v0 q_v0) q_v0))) (sz_lt_p_right q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))))
theorem step_first_unique {a q b o : CM} (h : Step a b o) (k : Step q b o) : a = q := by
  cases h with
  | raw =>
    cases k with
    | raw => rfl
    | hit hc =>
      have hb := code_bounds hc
      have hp := sz_lt_p_right a b
      exact (Nat.not_lt_of_ge (Nat.le_of_lt hp) hb.2).elim
  | hit hc =>
    cases k with
    | raw =>
      have hb := code_bounds hc
      have hp := sz_lt_p_right q b
      exact (Nat.not_lt_of_ge (Nat.le_of_lt hp) hb.2).elim
    | hit hk => exact code_key_unique hc hk
theorem code_unique {a b o q : CM} (h : Code a b o) (k : Code a b q) : o = q := by
  rcases code_shape h with ⟨q_x, q_v0, q_v1, q_H0, hs0, ha, hb, ho⟩
  rcases code_shape k with ⟨r_q_x, r_q_v0, r_q_v1, r_q_H0, rs0, ka, kb, ko⟩
  have et := congrArg (fun z => (L z)) (hb.symm.trans kb)
  have eo := congrArg (fun z => (L (L (R (R z))))) (hb.symm.trans kb)
  change q_H0 = r_q_H0 at et
  change q_v0 = r_q_v0 at eo
  rw [eo.symm, et.symm] at rs0
  have er := step_first_unique hs0 rs0
  have ex : q_x = r_q_x := er
  exact ho.trans (ex.trans ko.symm)
theorem step_ne_second {a b : CM} : ¬ Step a b b := by
  intro h
  cases h with
  | hit hc =>
    have hb := (code_bounds hc).2
    omega
theorem step_bound {a b o : CM} (h : Step a b o) :
    sz a < sz (p o b) := by
  cases h with
  | raw => simp [sz] <;> omega
  | hit hc =>
    have hb := (code_bounds hc).1
    simp [sz] at hb ⊢ <;> omega

noncomputable def eval (a b : CM) : CM := by
  classical
  exact if h : ∃ o, Code a b o then Classical.choose h else p a b
theorem eval_hit {{a b o : CM}} (h : Code a b o) : eval a b = o := by
  rw [eval, dif_pos ⟨o, h⟩]
  exact code_unique (Classical.choose_spec ⟨o, h⟩) h
theorem eval_raw {{a b : CM}} (h : ¬ ∃ o, Code a b o) : eval a b = p a b := by
  rw [eval, dif_neg h]
theorem eval_step (a b : CM) : Step a b (eval a b) := by
  by_cases h : ∃ o, Code a b o
  · rcases h with ⟨o, hc⟩
    rw [eval_hit hc]
    exact Step.hit hc
  · rw [eval_raw h]
    exact Step.raw a b
theorem nr0 (x v0 v1 : CM)
 :
    ¬ ∃ o, Code v0 v0 o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have qs0B := step_bound qs0
  cases qs0 with
  | raw =>
    have e0 := congrArg (fun q => q) ha
    change v0 = q_v0 at e0
    have e1 := congrArg (fun q => q) hb
    change v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) at e1
    have cyc : q_v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) := (let peq0 : v0 = q_v0 := e0; let peq1 : v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) := e1; let pst0 : q_v0 = v0 := Eq.symm (peq0); let pst1 : q_v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) := Eq.trans (pst0) (peq1); pst1)
    have hlt : sz q_v0 < sz (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) := Nat.lt_trans (sz_lt_p_right q_x q_v0) (sz_lt_p_left (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0)))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have e0 := congrArg (fun q => q) ha
    change v0 = q_v0 at e0
    have e1 := congrArg (fun q => q) hb
    change v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) at e1
    have cyc : q_v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) := (let peq0 : v0 = q_v0 := e0; let peq1 : v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) := e1; let pst0 : q_v0 = v0 := Eq.symm (peq0); let pst1 : q_v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) := Eq.trans (pst0) (peq1); pst1)
    have hlt : sz q_v0 < sz (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_v0)) (sz_lt_p_right q_v1 (p (p q_v0 q_v0) q_v0))) (sz_lt_p_right q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0)))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
theorem nr1 (x v0 v1 : CM)
 :
    ¬ ∃ o, Code (p v0 v0) v0 o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have qs0B := step_bound qs0
  cases qs0 with
  | raw =>
    have e0 := congrArg (fun q => q) ha
    change (p v0 v0) = q_v0 at e0
    have e1 := congrArg (fun q => q) hb
    change v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) at e1
    have cyc : v0 = (p (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := (let peq0 : (p v0 v0) = q_v0 := e0; let peq1 : v0 = (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) := e1; let pst0 : q_v0 = (p v0 v0) := Eq.symm (peq0); let pst1 : (p q_x q_v0) = (p q_x (p v0 v0)) := congrArg (fun q => p q_x q) (pst0); let pst2 : (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) = (p (p q_x (p v0 v0)) (p q_v1 (p (p q_v0 q_v0) q_v0))) := congrArg (fun q => p q (p q_v1 (p (p q_v0 q_v0) q_v0))) (pst1); let pst3 : (p q_v0 q_v0) = (p (p v0 v0) q_v0) := congrArg (fun q => p q q_v0) (pst0); let pst4 : (p (p v0 v0) q_v0) = (p (p v0 v0) (p v0 v0)) := congrArg (fun q => p (p v0 v0) q) (pst0); let pst5 : (p q_v0 q_v0) = (p (p v0 v0) (p v0 v0)) := Eq.trans (pst3) (pst4); let pst6 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) q_v0) := congrArg (fun q => p q q_v0) (pst5); let pst7 : (p (p (p v0 v0) (p v0 v0)) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := congrArg (fun q => p (p (p v0 v0) (p v0 v0)) q) (pst0); let pst8 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := Eq.trans (pst6) (pst7); let pst9 : (p q_v1 (p (p q_v0 q_v0) q_v0)) = (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0))) := congrArg (fun q => p q_v1 q) (pst8); let pst10 : (p (p q_x (p v0 v0)) (p q_v1 (p (p q_v0 q_v0) q_v0))) = (p (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := congrArg (fun q => p (p q_x (p v0 v0)) q) (pst9); let pst11 : (p (p q_x q_v0) (p q_v1 (p (p q_v0 q_v0) q_v0))) = (p (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Eq.trans (pst2) (pst10); let pst12 : v0 = (p (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Eq.trans (peq1) (pst11); pst12)
    have hlt : sz v0 < sz (p (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left v0 v0) (sz_lt_p_right q_x (p v0 v0))) (sz_lt_p_left (p q_x (p v0 v0)) (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have e0 := congrArg (fun q => q) ha
    change (p v0 v0) = q_v0 at e0
    have e1 := congrArg (fun q => q) hb
    change v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) at e1
    have cyc : v0 = (p q_H0 (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := (let peq0 : (p v0 v0) = q_v0 := e0; let peq1 : v0 = (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) := e1; let pst0 : q_v0 = (p v0 v0) := Eq.symm (peq0); let pst1 : (p q_v0 q_v0) = (p (p v0 v0) q_v0) := congrArg (fun q => p q q_v0) (pst0); let pst2 : (p (p v0 v0) q_v0) = (p (p v0 v0) (p v0 v0)) := congrArg (fun q => p (p v0 v0) q) (pst0); let pst3 : (p q_v0 q_v0) = (p (p v0 v0) (p v0 v0)) := Eq.trans (pst1) (pst2); let pst4 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) q_v0) := congrArg (fun q => p q q_v0) (pst3); let pst5 : (p (p (p v0 v0) (p v0 v0)) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := congrArg (fun q => p (p (p v0 v0) (p v0 v0)) q) (pst0); let pst6 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := Eq.trans (pst4) (pst5); let pst7 : (p q_v1 (p (p q_v0 q_v0) q_v0)) = (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0))) := congrArg (fun q => p q_v1 q) (pst6); let pst8 : (p q_H0 (p q_v1 (p (p q_v0 q_v0) q_v0))) = (p q_H0 (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := congrArg (fun q => p q_H0 q) (pst7); let pst9 : v0 = (p q_H0 (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Eq.trans (peq1) (pst8); pst9)
    have hlt : sz v0 < sz (p q_H0 (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left v0 v0) (sz_lt_p_left (p v0 v0) (p v0 v0))) (sz_lt_p_left (p (p v0 v0) (p v0 v0)) (p v0 v0))) (sz_lt_p_right q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) (sz_lt_p_right q_H0 (p q_v1 (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
theorem nr2 (x v0 v1 : CM)
 :
    ¬ ∃ o, Code v1 (p (p v0 v0) v0) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have qs0B := step_bound qs0
  cases qs0 with
  | raw =>
    have e0 := congrArg (fun q => q) ha
    change v1 = q_v0 at e0
    have e1 := congrArg (fun q => (L (L q))) hb
    change v0 = q_x at e1
    have e2 := congrArg (fun q => (R (L q))) hb
    change v0 = q_v0 at e2
    have e3 := congrArg (fun q => (R q)) hb
    change v0 = (p q_v1 (p (p q_v0 q_v0) q_v0)) at e3
    have cyc : q_v0 = (p q_v1 (p (p q_v0 q_v0) q_v0)) := (let peq1 : v0 = q_x := e1; let peq2 : v0 = q_v0 := e2; let peq3 : v0 = (p q_v1 (p (p q_v0 q_v0) q_v0)) := e3; let pst0 : q_x = v0 := Eq.symm (peq1); let pst1 : q_x = q_v0 := Eq.trans (pst0) (peq2); let pst2 : v0 = q_v0 := Eq.trans (peq1) (pst1); let pst3 : q_v0 = v0 := Eq.symm (pst2); let pst4 : q_v0 = (p q_v1 (p (p q_v0 q_v0) q_v0)) := Eq.trans (pst3) (peq3); pst4)
    have hlt : sz q_v0 < sz (p q_v1 (p (p q_v0 q_v0) q_v0)) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left q_v0 q_v0) (sz_lt_p_left (p q_v0 q_v0) q_v0)) (sz_lt_p_right q_v1 (p (p q_v0 q_v0) q_v0))
    exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
  | hit qs0h =>
    have hcB := code_bounds hc
    have qs0hB := code_bounds qs0h
    have qs0B := qs0B
    have p0 := ha
    change v1 = q_v0 at p0
    have z0 := congrArg sz p0
    have p1 := congrArg (fun q => (L q)) (hb)
    change (p v0 v0) = q_H0 at p1
    have z1 := congrArg sz p1
    have p2 := congrArg (fun q => (R q)) (hb)
    change v0 = (p q_v1 (p (p q_v0 q_v0) q_v0)) at p2
    have z2 := congrArg sz p2
    have p3 := ho
    change o = q_x at p3
    have z3 := congrArg sz p3
    simp only [L, R, U, sz] at hcB qs0hB qs0B z0 z1 z2 z3
    omega
theorem nr3 (x v0 v1 H0 : CM)
    (s0 : Step x v0 H0) :
    ¬ ∃ o, Code H0 (p v1 (p (p v0 v0) v0)) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have s0B := step_bound s0
  cases s0 with
  | raw =>
    have qs0B := step_bound qs0
    cases qs0 with
    | raw =>
      have e0 := congrArg (fun q => q) ha
      change (p x v0) = q_v0 at e0
      have e1 := congrArg (fun q => (L q)) hb
      change v1 = (p q_x q_v0) at e1
      have e2 := congrArg (fun q => (L (R q))) hb
      change (p v0 v0) = q_v1 at e2
      have e3 := congrArg (fun q => (R (R q))) hb
      change v0 = (p (p q_v0 q_v0) q_v0) at e3
      have cyc : v0 = (p (p (p x v0) (p x v0)) (p x v0)) := (let peq0 : (p x v0) = q_v0 := e0; let peq3 : v0 = (p (p q_v0 q_v0) q_v0) := e3; let pst0 : q_v0 = (p x v0) := Eq.symm (peq0); let pst1 : (p q_v0 q_v0) = (p (p x v0) q_v0) := congrArg (fun q => p q q_v0) (pst0); let pst2 : (p (p x v0) q_v0) = (p (p x v0) (p x v0)) := congrArg (fun q => p (p x v0) q) (pst0); let pst3 : (p q_v0 q_v0) = (p (p x v0) (p x v0)) := Eq.trans (pst1) (pst2); let pst4 : (p (p q_v0 q_v0) q_v0) = (p (p (p x v0) (p x v0)) q_v0) := congrArg (fun q => p q q_v0) (pst3); let pst5 : (p (p (p x v0) (p x v0)) q_v0) = (p (p (p x v0) (p x v0)) (p x v0)) := congrArg (fun q => p (p (p x v0) (p x v0)) q) (pst0); let pst6 : (p (p q_v0 q_v0) q_v0) = (p (p (p x v0) (p x v0)) (p x v0)) := Eq.trans (pst4) (pst5); let pst7 : v0 = (p (p (p x v0) (p x v0)) (p x v0)) := Eq.trans (peq3) (pst6); pst7)
      have hlt : sz v0 < sz (p (p (p x v0) (p x v0)) (p x v0)) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_right x v0) (sz_lt_p_left (p x v0) (p x v0))) (sz_lt_p_left (p (p x v0) (p x v0)) (p x v0))
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs0h =>
      have e0 := congrArg (fun q => q) ha
      change (p x v0) = q_v0 at e0
      have e1 := congrArg (fun q => (L q)) hb
      change v1 = q_H0 at e1
      have e2 := congrArg (fun q => (L (R q))) hb
      change (p v0 v0) = q_v1 at e2
