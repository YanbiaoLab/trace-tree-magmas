    have cyc : v0 = (p q_x (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))) := (let peq0 : (p v0 v0) = q_v0 := e0; let peq1 : v0 = (p q_x (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0)))) := e1; let pst0 : q_v0 = (p v0 v0) := Eq.symm (peq0); let pst1 : (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v0 v0) (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) := congrArg (fun q => p q (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) (pst0); let pst2 : (p q_v0 q_v0) = (p (p v0 v0) q_v0) := congrArg (fun q => p q q_v0) (pst0); let pst3 : (p (p v0 v0) q_v0) = (p (p v0 v0) (p v0 v0)) := congrArg (fun q => p (p v0 v0) q) (pst0); let pst4 : (p q_v0 q_v0) = (p (p v0 v0) (p v0 v0)) := Eq.trans (pst2) (pst3); let pst5 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) q_v0) := congrArg (fun q => p q q_v0) (pst4); let pst6 : (p (p (p v0 v0) (p v0 v0)) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := congrArg (fun q => p (p (p v0 v0) (p v0 v0)) q) (pst0); let pst7 : (p (p q_v0 q_v0) q_v0) = (p (p (p v0 v0) (p v0 v0)) (p v0 v0)) := Eq.trans (pst5) (pst6); let pst8 : (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0)) = (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))) := congrArg (fun q => p (p q_v1 q_x) q) (pst7); let pst9 : (p (p v0 v0) (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := congrArg (fun q => p (p v0 v0) q) (pst8); let pst10 : (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))) := Eq.trans (pst1) (pst9); let pst11 : (p q_x (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0)))) = (p q_x (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))) := congrArg (fun q => p q_x q) (pst10); let pst12 : v0 = (p q_x (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))) := Eq.trans (peq1) (pst11); pst12)
    have hlt : sz v0 < sz (p q_x (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))) := Nat.lt_trans (Nat.lt_trans (sz_lt_p_left v0 v0) (sz_lt_p_left (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0))))) (sz_lt_p_right q_x (p (p v0 v0) (p (p q_v1 q_x) (p (p (p v0 v0) (p v0 v0)) (p v0 v0)))))
