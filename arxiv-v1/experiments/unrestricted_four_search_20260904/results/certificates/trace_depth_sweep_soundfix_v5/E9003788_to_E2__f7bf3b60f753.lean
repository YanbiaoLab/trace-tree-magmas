theorem nr2 (x v0 v1 H0 : CM)
    (s0 : Step v1 x H0) :
    ¬ ∃ o, Code H0 (p (p v0 v0) v0) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have s0B := step_bound s0
  cases s0 with
  | raw =>
    have qs0B := step_bound qs0
    cases qs0 with
    | raw =>
      have e0 := congrArg (fun q => q) ha
      change (p v1 x) = q_v0 at e0
      have e1 := congrArg (fun q => (L q)) hb
      change (p v0 v0) = q_x at e1
      have e2 := congrArg (fun q => (R q)) hb
      change v0 = (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) at e2
      have cyc : v0 = (p (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) := (let peq0 : (p v1 x) = q_v0 := e0; let peq1 : (p v0 v0) = q_x := e1; let peq2 : v0 = (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) := e2; let pst0 : q_v0 = (p v1 x) := Eq.symm (peq0); let pst1 : (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v1 x) (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) := congrArg (fun q => p q (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) (pst0); let pst2 : q_x = (p v0 v0) := Eq.symm (peq1); let pst3 : (p q_v1 q_x) = (p q_v1 (p v0 v0)) := congrArg (fun q => p q_v1 q) (pst2); let pst4 : (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0)) = (p (p q_v1 (p v0 v0)) (p (p q_v0 q_v0) q_v0)) := congrArg (fun q => p q (p (p q_v0 q_v0) q_v0)) (pst3); let pst5 : (p q_v0 q_v0) = (p (p v1 x) q_v0) := congrArg (fun q => p q q_v0) (pst0); let pst6 : (p (p v1 x) q_v0) = (p (p v1 x) (p v1 x)) := congrArg (fun q => p (p v1 x) q) (pst0); let pst7 : (p q_v0 q_v0) = (p (p v1 x) (p v1 x)) := Eq.trans (pst5) (pst6); let pst8 : (p (p q_v0 q_v0) q_v0) = (p (p (p v1 x) (p v1 x)) q_v0) := congrArg (fun q => p q q_v0) (pst7); let pst9 : (p (p (p v1 x) (p v1 x)) q_v0) = (p (p (p v1 x) (p v1 x)) (p v1 x)) := congrArg (fun q => p (p (p v1 x) (p v1 x)) q) (pst0); let pst10 : (p (p q_v0 q_v0) q_v0) = (p (p (p v1 x) (p v1 x)) (p v1 x)) := Eq.trans (pst8) (pst9); let pst11 : (p (p q_v1 (p v0 v0)) (p (p q_v0 q_v0) q_v0)) = (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x))) := congrArg (fun q => p (p q_v1 (p v0 v0)) q) (pst10); let pst12 : (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0)) = (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x))) := Eq.trans (pst4) (pst11); let pst13 : (p (p v1 x) (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) := congrArg (fun q => p (p v1 x) q) (pst12); let pst14 : (p q_v0 (p (p q_v1 q_x) (p (p q_v0 q_v0) q_v0))) = (p (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) := Eq.trans (pst1) (pst13); let pst15 : v0 = (p (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) := Eq.trans (peq2) (pst14); pst15)
      have hlt : sz v0 < sz (p (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left v0 v0) (sz_lt_p_right q_v1 (p v0 v0))) (sz_lt_p_left (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x)))) (sz_lt_p_right (p v1 x) (p (p q_v1 (p v0 v0)) (p (p (p v1 x) (p v1 x)) (p v1 x))))
      exact (Nat.ne_of_lt hlt) (congrArg sz cyc)
    | hit qs0h =>
      rcases code_shape qs0h with ⟨u0_x, u0_v0, u0_v1, u0_H0, u0s0, u0a, u0b, u0o⟩
      have u0s0B := step_bound u0s0
      let u0s0out := u0_H0
