theorem nr4 (x v0 v1 H0 : CM)
    (s0 : Step v1 x H0) :
    ¬ ∃ o, Code x (p v0 (p H0 (p (p v0 v0) v0))) o := by
  rintro ⟨o, hc⟩
  rcases code_shape hc with ⟨q_x, q_v0, q_v1, q_H0, qs0, ha, hb, ho⟩
  have he : H0 = x := (let peq0 : x = q_v0 := ha; let peq2 : H0 = q_v0 := congrArg (fun q => (L (R q))) (hb); let pst0 : q_v0 = x := Eq.symm (peq0); let pst1 : H0 = x := Eq.trans (peq2) (pst0); pst1)
  exact step_ne_second (by simpa only [he] using s0)
theorem source_holds (x v0 v1 : CM) :
    x = (eval v0 (eval x (eval v0 (eval (eval v1 x) (eval (eval v0 v0) v0))))) := by
  let H0 := eval v1 x
  have e0a : v1 = v1 := by
    change v1 = v1
    rfl
  have e0b : x = x := by
    change x = x
    rfl
  have s0 : Step v1 x H0 := by
    rw [← e0a, ← e0b]
    exact eval_step v1 x
  change x = (eval v0 (eval x (eval v0 (eval H0 (eval (eval v0 v0) v0)))))
  have rawEq : (eval v0 (eval x (eval v0 (eval H0 (eval (eval v0 v0) v0))))) = (eval v0 (p x (p v0 (p H0 (p (p v0 v0) v0))))) := by
    calc
      (eval v0 (eval x (eval v0 (eval H0 (eval (eval v0 v0) v0))))) = (eval v0 (eval x (eval v0 (eval H0 (eval (p v0 v0) v0))))) := congrArg (fun q => (eval v0 (eval x (eval v0 (eval H0 (eval q v0)))))) (eval_raw (nr0 x v0 v1))
      _ = (eval v0 (eval x (eval v0 (eval H0 (p (p v0 v0) v0))))) := congrArg (fun q => (eval v0 (eval x (eval v0 (eval H0 q))))) (eval_raw (nr1 x v0 v1))
      _ = (eval v0 (eval x (eval v0 (p H0 (p (p v0 v0) v0))))) := congrArg (fun q => (eval v0 (eval x (eval v0 q)))) (eval_raw (nr2 x v0 v1 H0 s0))
      _ = (eval v0 (eval x (p v0 (p H0 (p (p v0 v0) v0))))) := congrArg (fun q => (eval v0 (eval x q))) (eval_raw (nr3 x v0 v1 H0 s0))
      _ = (eval v0 (p x (p v0 (p H0 (p (p v0 v0) v0))))) := congrArg (fun q => (eval v0 q)) (eval_raw (nr4 x v0 v1 H0 s0))
  exact (eval_hit (Code.law x v0 v1 H0 s0)).symm.trans rawEq.symm
