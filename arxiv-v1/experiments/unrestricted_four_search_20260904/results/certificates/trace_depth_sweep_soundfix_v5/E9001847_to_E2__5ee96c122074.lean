theorem source_holds (x v0 v1 : CM) :
    x = (eval (eval (eval v0 (eval v0 v1)) (eval (eval (eval v0 v0) v0) x)) v0) := by
  let H0 := eval v0 v1
  have e0a : v0 = v0 := by
    change v0 = v0
    rfl
  have e0b : v1 = v1 := by
    change v1 = v1
    rfl
  have s0 : Step v0 v1 H0 := by
    rw [← e0a, ← e0b]
    exact eval_step v0 v1
  let H1 := eval v0 (eval v0 v1)
  have e1a : v0 = v0 := by
    change v0 = v0
    rfl
  have e1b : (eval v0 v1) = H0 := by
