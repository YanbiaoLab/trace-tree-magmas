        have hlt : sz v1 < sz (p (p u0_v1 (p q_H0 (p (p v1 x) (p v1 x)))) (p u0_v0 u0_v0)) := Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (Nat.lt_trans (sz_lt_p_left v1 x) (sz_lt_p_left (p v1 x) (p v1 x))) (sz_lt_p_right q_H0 (p (p v1 x) (p v1 x)))) (sz_lt_p_right u0_v1 (p q_H0 (p (p v1 x) (p v1 x))))) (sz_lt_p_left (p u0_v1 (p q_H0 (p (p v1 x) (p v1 x)))) (p u0_v0 u0_v0))
