# Copy to .env and replace every placeholder. Never commit the real file.
E2B_API_KEY=<your-sandbox-api-key>
E2B_DOMAIN=<your-sandbox-api-domain>
SOLVER_SANDBOX_TEMPLATE=<your-compatible-sandbox-template>
JUDGE_V3_BASE_URL=<your-remote-judge-v3-base-url>

# Values frozen by config/run_config.json.
SOLVER_SANDBOX_MAX_RUNNING=120
SOLVER_SANDBOX_CREATE_RATE=25
SOLVER_SANDBOX_TIMEOUT_SECONDS=125
SOLVER_SANDBOX_MAX_JUDGE_CALLS=20
SOLVER_SANDBOX_REQUEST_TIMEOUT_SECONDS=300

# Optional private CA path; the certificate itself must not be committed.
# SOLVER_SANDBOX_CA_CERT=<path-to-private-ca-certificate>
